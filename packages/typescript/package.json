{
  "name": "@pharos/discovery",
  "version": "0.1.0",
  "description": "Discovery SDK for MCP servers — search, approve, connect",
  "license": "MIT",
  "author": "Chris Wykel <chris@getpharos.dev>",
  "homepage": "https://discoverpharos.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wpnx330/pharos-discovery"
  },
  "bugs": {
    "url": "https://github.com/Wpnx330/pharos-discovery/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "discovery",
    "registry",
    "ai",
    "agent"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
